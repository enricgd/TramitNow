# Copia este fichero a .env.production.local (no se sube a git) antes de desplegar en el NAS.
# En desarrollo no hace falta: se usa el Supabase Auth local a través del proxy de Vite.

# URL pública de Supabase (auth y storage)
VITE_SUPABASE_URL=https://api.henrik11.duckdns.org
# ANON_KEY del .env del NAS (/volume1/docker/tramitnow/proyecto/.env). Es pública por diseño.
VITE_SUPABASE_ANON_KEY=
# URL pública de apps/api (las rutas /v1/*)
VITE_API_URL=https://api.henrik11.duckdns.org
