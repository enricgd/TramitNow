# Copia a .env para `npm run dev` (el .env no se sube a git). Valores de la base local de db/local.
DATABASE_URL=postgresql://tramitnow_api:tramitnow-api-local@127.0.0.1:54322/postgres
# JWT_SECRET de db/local/dev.env (en el NAS, el JWT_SECRET del .env de Supabase).
SUPABASE_JWT_SECRET=tramitnow-local-solo-desarrollo-no-usar-en-el-nas
CORS_ORIGINS=http://localhost:5173
PORT=3000
# Supabase Storage local (documentos): la API firma las URL con la service_role de db/local/dev.env.
STORAGE_URL=http://127.0.0.1:54325
# URL de Storage tal como la ve el navegador, para las URL firmadas de subida y descarga. Por defecto, STORAGE_URL.
# En local, Storage no responde a CORS desde el navegador: la web (Vite, puerto 5173) hace de proxy de /storage/v1
# hacia 127.0.0.1:54325 (proxy de Vite de apps/web), así que el navegador entra por ahí.
# En el NAS no cambia: https://api.<dominio>/storage/v1 (ver infra/nas/README.md).
STORAGE_PUBLIC_URL=http://localhost:5173/storage/v1
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoidHJhbWl0bm93LWxvY2FsIiwiaWF0IjoxNzYzMTY0ODAwLCJleHAiOjQxMDI0NDQ4MDB9.QvMaExky6s_AHy_Md8ZhO0mQaOcj6kc3KhNc7H8Z5JY
# Supabase Auth (GoTrue) para invitar usuarios desde Mi ETT, con la misma service_role. Sin AUTH_URL, esas rutas dan 503.
# En el NAS: http://auth:9999 (red de Docker).
AUTH_URL=http://127.0.0.1:9999
# Web a la que lleva el enlace de invitación: la API lo monta como <INVITE_REDIRECT_URL>verify?token=…&type=invite
# (página /verify de la web). En el NAS: https://demo.<dominio>/
INVITE_REDIRECT_URL=http://localhost:5173/
# true cuando Auth tenga correo saliente (SMTP): lo envía Auth y la API ya no devuelve el enlace.
AUTH_SENDS_INVITES=false
# Cifrado de datos personales (DNI/NIE, Seguridad Social, IBAN, salud): AES-256-GCM en la API.
# PERSONAL_DATA_KEYS: claves por versión «vN:<base64 de 32 bytes>», separadas por comas; se cifra con
# PERSONAL_DATA_KEY_ID (por defecto, la última) y se descifra con la que diga el prefijo del dato (rotación).
# PERSONAL_DATA_HMAC_KEY: huella del documento para buscar duplicados (no se rota sin recalcular las huellas).
# Estas son SOLO DE DESARROLLO (base local); en el NAS se generan con `openssl rand -base64 32` (infra/nas/README.md).
# Sin ellas, las rutas que guardan o enseñan datos sensibles responden 503.
PERSONAL_DATA_KEYS=v1:ISTPEa5/czJfRyVopjcEP8N/4Ns7x5lm7oIiA6A3piA=
PERSONAL_DATA_HMAC_KEY=6Uobx0vqGNcFRr3H/rVbqd0ZBoIrAYjc++Cl0VbV4bo=
