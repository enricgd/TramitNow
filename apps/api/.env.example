# Copia a .env para `npm run dev` (el .env no se sube a git). Valores de la base local de db/local.
DATABASE_URL=postgresql://tramitnow_api:tramitnow-api-local@127.0.0.1:54322/postgres
# JWT_SECRET de db/local/dev.env (en el NAS, el JWT_SECRET del .env de Supabase).
SUPABASE_JWT_SECRET=tramitnow-local-solo-desarrollo-no-usar-en-el-nas
CORS_ORIGINS=http://localhost:5173
PORT=3000
# Supabase Storage local (documentos): la API firma las URL con la service_role de db/local/dev.env.
STORAGE_URL=http://127.0.0.1:54325
# URL de Storage tal como la ve el navegador, para las URL firmadas de subida y descarga. Por defecto, STORAGE_URL.
# En local, Storage no responde a CORS desde el navegador: la web (Vite, puerto 5173) hace de proxy de /storage/v1
# hacia 127.0.0.1:54325 (proxy de Vite de apps/web), así que el navegador entra por ahí.
# En el NAS no cambia: https://api.<dominio>/storage/v1 (ver infra/nas/README.md).
STORAGE_PUBLIC_URL=http://localhost:5173/storage/v1
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoidHJhbWl0bm93LWxvY2FsIiwiaWF0IjoxNzYzMTY0ODAwLCJleHAiOjQxMDI0NDQ4MDB9.QvMaExky6s_AHy_Md8ZhO0mQaOcj6kc3KhNc7H8Z5JY
