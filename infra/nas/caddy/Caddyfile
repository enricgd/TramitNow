{
	email {$ACME_EMAIL}
}

# Certificado comodín vía reto DNS de DuckDNS: no hace falta abrir el puerto 80.
*.{$DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}

	# Supabase: solo auth y storage. Los datos van por la API propia (apps/api, /v1 y su especificación),
	# así que PostgREST (/rest/v1) no se publica. Studio (/dashboard) queda solo en la red local.
	@api host api.{$DOMAIN}
	handle @api {
		@public path /auth/v1/* /storage/v1/*
		handle @public {
			reverse_proxy api-gw:8000
		}
		@tramitnow path /v1/* /openapi.json
		handle @tramitnow {
			reverse_proxy api:3000
		}
		respond 404
	}

	# Demo de la web, protegida con usuario y contraseña mientras no se enseñe.
	@demo host demo.{$DOMAIN}
	handle @demo {
		basic_auth {
			{$DEMO_USER} {$DEMO_PASSWORD_HASH}
		}
		root * /srv/demo
		try_files {path} /index.html
		file_server
	}

	# Web en modo demo: datos de ejemplo en el propio navegador, sin login, sin Supabase ni API
	# (deploy-web-ejemplo.sh). Abierta a propósito: no contiene datos reales ni llega a la base de datos.
	@ejemplo host ejemplo.{$DOMAIN}
	handle @ejemplo {
		header X-Robots-Tag "noindex, nofollow"

		# Preguntas abiertas para el equipo (infra/nas/preguntas): sin datos personales.
		@preguntas path_regexp preguntas (?i)^/preguntastorre(/.*)?$
		handle @preguntas {
			reverse_proxy preguntas:3000
		}

		handle {
			root * /srv/ejemplo
			try_files {path} /index.html
			file_server
		}
	}

	# Web corporativa (web-corporativa/, deploy-web-corporativa.sh). Sin indexar mientras esté en este dominio provisional.
	@web host web.{$DOMAIN}
	handle @web {
		header X-Robots-Tag "noindex, nofollow"
		root * /srv/corporativa
		try_files {path} /index.html
		file_server
	}

	handle {
		abort
	}
}
