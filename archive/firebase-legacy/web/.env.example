# Firebase Web SDK configuration.
# These NEXT_PUBLIC values are included in the browser bundle. Do not place
# private keys, service-account JSON, database passwords, or admin secrets here.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tramitnow-development.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tramitnow-development
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id
