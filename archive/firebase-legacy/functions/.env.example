# Cloud SQL connection used by the deployed Cloud Functions.
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=tramitnow-sql-database
INSTANCE_CONNECTION_NAME=tramitnow-development:us-east4:tramitnow-sql-instance

# Exact frontend origin allowed by CORS. Do not add a trailing slash.
WEB_ORIGIN=https://tramitnow-development.web.app

# Configure at least one value before calling setupSuperadmin.
# If both are configured, the authenticated user must match both values.
SUPERADMIN_UID=
SUPERADMIN_EMAIL=

# GRAPHQL_URL is intentionally omitted because the current Functions code does
# not read it.
